# Copia in .env e compila. NON committare .env.

# --- LLM (via LiteLLM) ---
# Per Gemini: chiave da https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modello LiteLLM. Alternative piu' economiche: gemini/gemini-flash-lite-latest , gemini/gemini-3.5-flash-lite
LLM_MODEL=gemini/gemini-3.6-flash
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30

# --- Verticale demo ---
# 'acme' = gestionale (distribuzione arredo, SQLite) | 'ecom' = e-commerce
# "Nuvola Shop" (SQLite) | 'gest' = gestionale acquisti+preventivi su MySQL REALE.
# Seleziona in blocco: motore DB + viste ai_bi_* + glossario + domande d'oro.
VERTICAL=acme

# --- Database demo (override opzionale) ---
# Vuoto = derivato dal VERTICALE (acme -> db/acme.db, ecom -> db/nuvola.db).
# Impostalo solo per puntare a un file SQLite custom. Per VERTICAL=gest e'
# IGNORATO (si usa la connessione MySQL sotto).
DB_PATH=

# --- Motore DB e connessione MySQL/MariaDB (solo VERTICAL=gest) ---
# DB_ENGINE: 'sqlite' (default per acme/ecom) | 'mysql'. In produzione lo
# imposta deploy-cbi.sh con -e DB_ENGINE=mysql SOLO sul container gest, quindi
# queste righe possono restare compilate anche nel .env comune: acme/ecom le
# ignorano. L'utente DB deve avere SOLO privilegi SELECT.
DB_ENGINE=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Limiti di sicurezza query ---
SQL_ROW_LIMIT=1000
SQL_TIMEOUT_S=8

# --- Rate limiting demo pubblica ---
RATE_MAX_REQ=20
RATE_WINDOW_S=600
# Tetto giornaliero di chiamate LLM (protezione budget). 0 = illimitato.
DAILY_LLM_CAP=800

# --- CORS: origini ammesse per il widget (separate da virgola) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Logging ---
LOG_DIR=./logs
