# Copia in .env e compila. NON committare .env.

# --- LLM (via LiteLLM) ---
# Per Gemini: chiave da https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modello LiteLLM. Alternative piu' economiche: gemini/gemini-flash-lite-latest , gemini/gemini-3.5-flash-lite
LLM_MODEL=gemini/gemini-3.6-flash
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30

# --- Database demo ---
# Percorso al file SQLite generato da demo/db/seed.py
DB_PATH=../db/acme.db

# --- Limiti di sicurezza query ---
SQL_ROW_LIMIT=1000
SQL_TIMEOUT_S=8

# --- Rate limiting demo pubblica ---
RATE_MAX_REQ=20
RATE_WINDOW_S=600
# Tetto giornaliero di chiamate LLM (protezione budget). 0 = illimitato.
DAILY_LLM_CAP=800

# --- CORS: origini ammesse per il widget (separate da virgola) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Logging ---
LOG_DIR=./logs
